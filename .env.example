# Template for your database settings.
# Copy this file to ".env" and fill in your real values.
# ".env" is listed in .gitignore, so your password never reaches GitHub.

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=olist
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# --- Airflow (stage 5) ---
# Login for the Airflow UI at http://localhost:8080
AIRFLOW_ADMIN_USERNAME=admin
AIRFLOW_ADMIN_PASSWORD=change_me
# Password for Airflow's own small metadata database (a separate container)
AIRFLOW_DB_PASSWORD=change_me
# Encrypts connection passwords stored by Airflow. Generate one with:
#   python -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=change_me
# Shared secret so Airflow's components trust each other. Any long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=change_me
