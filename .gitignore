# --- Secrets: never commit real credentials ---
.env
.streamlit/secrets.toml

# --- Python ---
.venv/
__pycache__/
*.pyc

# --- Data: the Olist CSVs are large and come from Kaggle, so we don't commit them ---
data/raw/*
!data/raw/.gitkeep

# --- Logs written by our scripts ---
logs/

# --- dbt build output and logs ---
dbt/target/
dbt/logs/
dbt/dbt_packages/
dbt/.user.yml

# --- Airflow: generated at runtime ---
airflow/logs/
airflow/config/
airflow/plugins/
airflow/dags/__pycache__/

# --- Private notes (kept outside the public repo) ---
docs/interview_prep.md

# --- Editor / OS files ---
.vscode/
.DS_Store
Thumbs.db
